# Python
__pycache__/
*.pyc
*.pyo

# 虚拟环境与模型缓存（体积大，不入库）
whisperASR_env/
models/

# data/ 是 B 站缓存原件：全量不入库，仅保留一个脱敏样例目录展示结构
# （c_00000000000 为示例：audio.m4s / video.m4s 置空，entry.json 已脱敏）
data/*
!data/c_00000000000/

# data_backup/：样例集的完整本地备份（含真实音频），不入库
data_backup/

# 流水线瞬态：临时文件、WAV、日志、冒烟产物
work/
logs/
.workbuddy/

# conn/ 含 SSH 私钥与服务器地址（asr.env），严禁入库——仓库有公开 remote
conn/

# dist/：发布包产物（index.html 由 build_site.py --mode minimal 生成），不入库
dist/

# output/：产出物总目录（转写/候选词/索引/复习站/逐集学习笔记），2026-11-08 起整体不入库
# 注意：md/NN_*.md 为手工整理内容、仓库内无生成脚本，撤销跟踪后仅存本地，请另行备份
output/

# intensive/：精读页产物（由 build_intensive.py 从 transcripts/ 再生，含全量句级字幕），不入库
intensive/

# macOS
.DS_Store

# vim swap 文件
*.swp
*.swo
*~

# 服务器侧工作产物（2026-11-07 补）
output.bak-*/
.venv/
*.bak
*.log
.pytest_cache/

# 本地工作笔记 / AI 工具项目级配置，不入库
Notes.md
TASK.md
.codebuddy/
